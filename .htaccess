# Hostinger (LiteSpeed reads Apache rules). Merge with any .htaccess already on the server.
ErrorDocument 404 /404.html

RewriteEngine On

# Hostinger deploys the site from GitHub, which leaves the repository's own files (.git, .gitignore)
# beside it: refuse anything whose name starts with a dot, except .well-known (certificate renewals).
RewriteRule (^|/)\.(?!well-known/) - [F,L]

# One host: www. goes to the bare domain (Hostinger already forces https).
RewriteCond %{HTTP_HOST} ^www\.payrollprotect\.co\.uk$ [NC]
RewriteRule ^ https://payrollprotect.co.uk%{REQUEST_URI} [R=301,L,NE]

# The home page lives at /, not /index.html (only for requests typed or linked as /index.html).
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Types the server may not know.
AddType application/manifest+json .webmanifest
AddType text/vtt .vtt

# Compression for everything that is text (LiteSpeed also brotli-compresses where it is enabled).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json application/xml text/xml image/svg+xml text/vtt text/plain
</IfModule>

# Caching. Every stylesheet and script is linked with a content version (?v=, tools/stamp.py), so a
# changed file always arrives under a new address: those keep for a year. Images, fonts, films and
# captions keep for 30 days. Pages, the sitemap and the manifest are checked every time, so a deploy
# shows at once.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|png|jpe?g|svg|ico|woff2|mp4|vtt)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
